# Local environment template. Copy to .env and fill in.
#
# NOTE: as of this commit nothing in src/ reads these variables. The Supabase
# URL and publishable (anon) key are hardcoded in
# src/integrations/supabase/client.ts, which Lovable generates. Both are
# public by design - the anon key ships inside the JS bundle either way, and
# access is governed by row-level security, not by key secrecy.
#
# These are kept so that the project can be pointed at a different Supabase
# instance without editing generated code, and so there is an obvious place
# for local-only settings. A service-role key must never be put in this file:
# it bypasses RLS, and anything in a VITE_-prefixed variable is compiled into
# the client bundle. Server-side keys belong in Supabase function secrets or
# GitHub Actions secrets (see .github/workflows/sync-growsmart.yml).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
